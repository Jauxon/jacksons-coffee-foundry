# Copy to /etc/coffee/coffee.env on the droplet and fill in.
# Loaded by systemd (EnvironmentFile) so these are real process env vars.

NODE_ENV=production
PORT=3000

# SQLite file on the droplet's persistent disk. Survives deploys + reboots.
# Point this at an attached Block Storage volume (e.g. /mnt/coffee/coffee.db)
# if you want the DB independently snapshottable.
DB_PATH=/var/lib/coffee/coffee.db

# Your Anthropic key. Without it the app falls back to the heuristic agent.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: LLM calls allowed per server instance (default 3).
# On a single always-on droplet you can raise this since there's no cold-start churn.
LLM_CALL_BUDGET=3

# Public URL of the site. Makes social/OG preview image links absolute so
# iMessage / Slack / LinkedIn / X render the rich card. Use your domain once you
# have one (e.g. https://operator.example.com); the droplet IP works too:
# SITE_URL=http://YOUR_DROPLET_IP
